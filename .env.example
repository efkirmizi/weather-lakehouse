# ---------------------------------------------------------------------------
# Local lakehouse stack - example environment file
#
#   cp .env.example .env
#
# .env must sit in the same directory as docker-compose.yml (or be passed with
# --env-file). Add .env to .gitignore and commit this example instead.
#
# Compose .env parsing rules that will bite you:
#   - no spaces around '=', no 'export' prefix
#   - a literal '$' must be written '$$', otherwise Compose interpolates it
#   - keep comments on their own line; ' #' after a value is stripped as a comment
#   - stick to letters, digits, '_' and '-' in passwords. These values get
#     interpolated into a JDBC URL and into the minio-init shell command, so
#     quotes, '$', '#' and '/' fail in confusing ways rather than clearly.
#
# Everything below is a DEV credential for a stack that only listens on
# localhost. Do not reuse these values anywhere that matters.
# ---------------------------------------------------------------------------


# Prefix for container and volume names, e.g. lakehouse_minio_data.
# Without it, Compose uses the directory name - which changes if you rename
# the folder, silently orphaning your volumes.
COMPOSE_PROJECT_NAME=


# --- MinIO (object storage) -------------------------------------------------
# The root account. Used only to create the buckets and the service account
# below - no job or service authenticates with it.
# User: 3 chars minimum. Password: 8 chars minimum, or MinIO exits at startup.
MINIO_ADMIN_USER=
MINIO_ADMIN_PASSWORD=


# The scoped service account every job actually uses: Nessie's warehouse writes,
# Spark's direct reads, MLflow's artifact store, the serving API. minio-init
# creates it with the built-in 'readwrite' policy on first start.
#
# Set BOTH or NEITHER. Leaving both blank falls back to the root credentials above -
# the stack still comes up, it just gives every container admin rights on MinIO.
# Filling in only one is a configuration error and minio-init refuses to start:
# services would authenticate with a mismatched user/password pair.
# Same character rules as above.
MINIO_APP_USER=
MINIO_APP_PASSWORD=


# --- Postgres (Nessie version store) ----------------------------------------
# Read only on the FIRST start, when the postgres_data volume is empty.
# Editing these later has no effect until you run:
#   docker compose down -v
NESSIE_DB_NAME=
NESSIE_DB_USER=
NESSIE_DB_PASSWORD=


# Encrypts Airflow connection passwords at rest (the S3 keys now live in the
# minio_s3 connection rather than in the scheduler's environment). Leave it blank and
# Airflow still works, it just stores them in clear text. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=


# --- Airflow web UI ---------------------------------------------------------
# Also handed to the drift monitor as AIRFLOW_API_USER / AIRFLOW_API_PASSWORD so
# it can trigger retraining through the REST API.
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=


AIRFLOW_DB_NAME=
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=


# GID of the host's docker group: `getent group docker | cut -d: -f3`.
# The Airflow scheduler needs it to reach /var/run/docker.sock and launch the job
# containers. The webserver deliberately does not get the socket.
DOCKER_GID=