# ---------------------------------------------------------------------------
# Local lakehouse stack - example environment file
#
#   cp .env.example .env
#
# .env must sit in the same directory as docker-compose.yml (or be passed with
# --env-file). Add .env to .gitignore and commit this example instead.
#
# Compose .env parsing rules that will bite you:
#   - no spaces around '=', no 'export' prefix
#   - a literal '$' must be written '$$', otherwise Compose interpolates it
#   - keep comments on their own line; ' #' after a value is stripped as a comment
#   - stick to letters, digits, '_' and '-' in passwords. These values get
#     interpolated into a JDBC URL and into the minio-init shell command, so
#     quotes, '$', '#' and '/' fail in confusing ways rather than clearly.
#
# Everything below is a DEV credential for a stack that only listens on
# localhost. Do not reuse these values anywhere that matters.
# ---------------------------------------------------------------------------


# Prefix for container and volume names, e.g. lakehouse_minio_data.
# Without it, Compose uses the directory name - which changes if you rename
# the folder, silently orphaning your volumes.
COMPOSE_PROJECT_NAME=


# --- MinIO (object storage) -------------------------------------------------
# These double as the S3 credentials Nessie uses for the warehouse and that
# Spark uses for direct reads, so all three services move together if you
# change them.
# User: 3 chars minimum. Password: 8 chars minimum, or MinIO exits at startup.
MINIO_ADMIN_USER=
MINIO_ADMIN_PASSWORD=


# --- Postgres (Nessie version store) ----------------------------------------
# Read only on the FIRST start, when the postgres_data volume is empty.
# Editing these later has no effect until you run:
#   docker compose down -v
NESSIE_DB_NAME=
NESSIE_DB_USER=
NESSIE_DB_PASSWORD=


_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=


AIRFLOW_DB_NAME=
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=


DOCKER_GID=